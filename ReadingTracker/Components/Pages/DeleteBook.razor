@page "/books/delete/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@using ReadingTracker.Models
@using ReadingTracker.Services
@attribute [Authorize]
@inject IBookService BookService
@inject NavigationManager Navigation

<PageTitle>Delete Book</PageTitle>

<div class="container">
    <h1 class="mb-3">Delete Book</h1>

    @if (loading)
    {
        <p role="status">Loading book...</p>
    }
    else if (loadFailed)
    {
        <div class="alert alert-danger" role="alert">Could not load the book. Please try again.</div>
        <a class="btn btn-outline-secondary" href="books">Back to My Books</a>
    }
    else if (book is null)
    {
        <div class="alert alert-warning" role="alert">Book not found.</div>
        <a class="btn btn-outline-secondary" href="books">Back to My Books</a>
    }
    else
    {
        <div class="card p-3 col-12 col-lg-6">
            <p class="fs-5 mb-1">Delete "@book.Title"?</p>
            <p class="mb-3">by @book.Author. This cannot be undone.</p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" role="alert">@errorMessage</div>
            }

            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-secondary" href="books">Cancel</a>
                <button type="button" class="btn btn-danger" disabled="@isDeleting" @onclick="DeleteAsync">
                    @(isDeleting ? "Deleting..." : "Delete Book")
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private Book? book;
    private bool loading = true;
    private bool loadFailed;
    private bool isDeleting;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        loadFailed = false;

        try
        {
            book = await BookService.GetMyBookAsync(Id);
        }
        catch (Exception)
        {
            loadFailed = true;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task DeleteAsync()
    {
        isDeleting = true;
        errorMessage = null;

        try
        {
            var deleted = await BookService.DeleteBookAsync(Id);

            if (deleted)
            {
                Navigation.NavigateTo("books?message=deleted");
                return;
            }

            errorMessage = "Book not found, so it was not deleted.";
        }
        catch (Exception)
        {
            errorMessage = "Could not delete the book. Please try again.";
        }

        isDeleting = false;
    }
}