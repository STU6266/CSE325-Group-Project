@page "/books"
@using Microsoft.AspNetCore.Authorization
@using ReadingTracker.Models
@using ReadingTracker.Services
@attribute [Authorize]
@inject IBookService BookService

<PageTitle>My Books</PageTitle>

<div class="container">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="mb-0">My Books</h1>
        <a class="btn btn-primary" href="books/add">+ Add Book</a>
    </div>

    @if (!string.IsNullOrEmpty(MessageText))
    {
        <div class="alert alert-success" role="status">@MessageText</div>
    }

    @if (loadFailed)
    {
        <div class="alert alert-danger" role="alert">
            Could not load your books. Please try again.
            <button type="button" class="btn btn-outline-danger btn-sm ms-2" @onclick="LoadBooksAsync">Retry</button>
        </div>
    }
    else if (books is null)
    {
        <p role="status">Loading your books...</p>
    }
    else if (books.Count == 0)
    {
        <div class="card p-3 mb-4">
            <p class="mb-3">No books yet. Add your first book.</p>
            <div><a class="btn btn-primary" href="books/add">Add Book</a></div>
        </div>
    }
    else
    {
        <div class="mb-4">
            <label for="statusFilter" class="form-label">Filter</label>
            <select id="statusFilter" class="form-select" @bind="filter">
                <option value="All">All Books</option>
                <option value="WantToRead">Want to Read</option>
                <option value="Reading">Reading</option>
                <option value="Finished">Finished</option>
            </select>
        </div>

        @if (!FilteredBooks.Any())
        {
            <div class="card p-3">
                <p class="mb-3">No books match this filter.</p>
                <div>
                    <button type="button" class="btn btn-outline-secondary" @onclick="ShowAll">Show all books</button>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var book in FilteredBooks)
                {
                    <div class="col-12 col-md-6">
                        <div class="card h-100">
                            <div class="card-body p-3">
                                <h2 class="h5 card-title">@book.Title</h2>
                                <p class="card-text mb-2">@book.Author</p>
                                <p class="mb-3">
                                    <span class="@StatusBadgeClass(book.Status)">@StatusText(book.Status)</span>
                                </p>
                                <div class="d-flex flex-wrap gap-2">
                                    <a class="btn btn-outline-primary" href="@($"books/edit/{book.Id}")">Edit</a>
                                    <a class="btn btn-outline-danger" href="@($"books/delete/{book.Id}")">Delete</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "message")]
    public string? Message { get; set; }

    private List<Book>? books;
    private bool loadFailed;
    private string filter = "All";

    private string? MessageText => Message switch
    {
        "added" => "Book added.",
        "updated" => "Book updated.",
        "deleted" => "Book deleted.",
        _ => null
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadBooksAsync();
    }

    private async Task LoadBooksAsync()
    {
        try
        {
            books = await BookService.GetMyBooksAsync();
            loadFailed = false;
        }
        catch (Exception)
        {
            books = null;
            loadFailed = true;
        }
    }

    private IEnumerable<Book> FilteredBooks => filter switch
    {
        "WantToRead" => books!.Where(b => b.Status == ReadingStatus.WantToRead),
        "Reading" => books!.Where(b => b.Status == ReadingStatus.Reading),
        "Finished" => books!.Where(b => b.Status == ReadingStatus.Finished),
        _ => books!
    };

    private void ShowAll() => filter = "All";

    // Temporary inline display. Replace with Wadzanai's ReadingStatusBadge during RT-17.
    private static string StatusText(ReadingStatus status) => status switch
    {
        ReadingStatus.WantToRead => "Want to Read",
        ReadingStatus.Reading => "Reading",
        ReadingStatus.Finished => "Finished",
        _ => status.ToString()
    };

    private static string StatusBadgeClass(ReadingStatus status) => status switch
    {
        ReadingStatus.WantToRead => "badge text-bg-secondary",
        ReadingStatus.Reading => "badge text-bg-primary",
        ReadingStatus.Finished => "badge text-bg-success",
        _ => "badge text-bg-secondary"
    };
}