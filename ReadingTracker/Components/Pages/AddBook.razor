@page "/books/add"
@using Microsoft.AspNetCore.Authorization
@using ReadingTracker.Components.Books
@using ReadingTracker.Models
@using ReadingTracker.Services
@attribute [Authorize]
@inject IBookService BookService
@inject NavigationManager Navigation

<PageTitle>Add Book</PageTitle>

<div class="container">
    <h1 class="mb-3">Add Book</h1>
    <div class="row">
        <div class="col-12 col-lg-6">
            <BookForm Model="book"
                      SubmitText="Save Book"
                      IsSaving="isSaving"
                        ErrorMessage="@errorMessage"
                      OnSave="SaveAsync" />
        </div>
    </div>
</div>

@code {
    private Book book = new();
    private bool isSaving;
    private string? errorMessage;

    private async Task SaveAsync()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            await BookService.AddBookAsync(book);
            Navigation.NavigateTo("books?message=added");
        }
        catch (Exception)
        {
            errorMessage = "Could not save the book. Please check the fields and try again.";
            isSaving = false;
        }
    }
}